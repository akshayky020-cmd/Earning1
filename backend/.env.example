# Database Configuration
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database_name
# For Local MongoDB: mongodb://localhost:27017/database_name
MONGODB_URI=mongodb://localhost:27017/earning_platform

# Server Configuration
PORT=5001
NODE_ENV=development

# JWT Configuration
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=your_jwt_access_secret_here_generate_with_openssl_rand_-hex_32
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_generate_with_openssl_rand_-hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# API Keys (Get from respective services)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Email Configuration (Optional - if you need email services)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Frontend URL (for CORS)
FRONTEND_URL=https://earning1-lime.vercel.app

# Default admin bootstrap credentials
# IMPORTANT: Change these in production!
DEFAULT_ADMIN_EMAIL=admin@earning.com
DEFAULT_ADMIN_PASSWORD=change_this_password_in_production
